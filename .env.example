# Storage backend — `local` (default) or `s3://bucket/prefix`
EARTHDATA_STORAGE=local
# Root for the local filesystem backend (materialized Zarr/Parquet land here)
EARTHDATA_DATA_DIR=./data
# Materialization cache eviction cap (bytes); default ~50 GiB
EARTHDATA_CACHE_MAX_BYTES=53687091200
# Ceiling on bytes one workspace may hold pinned via pin_result; default ~10 GiB
EARTHDATA_PINNED_BYTES_MAX_PER_WORKSPACE=10737418240
# Build cost assumed for a result whose job never recorded one (seconds)
EARTHDATA_REBUILD_COST_DEFAULT_SECONDS=60
# How often orphan-blob reclamation runs (seconds); debris cleanup, not admission control
EARTHDATA_ORPHAN_SWEEP_INTERVAL_SECONDS=3600

# Adjacent-granule prefetch — warm the next contiguous time window after a
# retrieval completes. OFF by default: it spends provider quota, worker capacity
# and cache bytes on data nobody asked for. Turn it on, then read
# `prefetch-hit` over `prefetch-issued` out of the logs.
EARTHDATA_PREFETCH_ENABLED=false
# Ceiling on one speculative retrieval's estimated size (bytes); default ~2 GiB
EARTHDATA_PREFETCH_MAX_BYTES=2147483648
# Speculative jobs one workspace may be issued per rolling day
EARTHDATA_PREFETCH_BUDGET_PER_WORKSPACE_PER_DAY=24
# How long a predicted window must already be in the past before it is
# prefetchable — stands in for the collection's own data latency
EARTHDATA_PREFETCH_MIN_WINDOW_AGE_HOURS=48

# Database (SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/earthdata_mcp

# Worker broker (Arq / Redis)
REDIS_URL=redis://localhost:6379/0

# NASA Earthdata Login — register at urs.earthdata.nasa.gov (used from Phase 4)
EDL_USERNAME=
EDL_PASSWORD=
EARTHDATA_TOKEN=

# Logging
LOG_LEVEL=INFO

# MCP transport — `stdio` (default, the consumer spawns this as a child
# process) or `http` (streamable HTTP, for a consumer in a separate
# container/compose stack). Host/port only matter under http.
EARTHDATA_MCP_TRANSPORT=stdio
EARTHDATA_MCP_HOST=0.0.0.0
EARTHDATA_MCP_PORT=8765
# Static bearer token required on every HTTP request when set (ignored under
# stdio). A tripwire for a private-network lab box, not real authn — see
# README's security posture note before exposing this beyond that.
EARTHDATA_MCP_TOKEN=
